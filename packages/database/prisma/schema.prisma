// Welfare Facility ERP Suite - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 事業所情報
model Facility {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique // 事業所コード
  type          String   // 施設種別（特養、デイサービス等）
  address       String?
  phone         String?
  email         String?
  capacity      Int?     // 定員
  licenseNumber String?  // 事業所番号
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  residents      Resident[]
  staff          Staff[]
  shifts         Shift[]
  claims         Claim[]
  incidentReports IncidentReport[]
  tasks          Task[]
  documents      Document[]

  @@map("facilities")
}

// 入所者/利用者
model Resident {
  id                String    @id @default(cuid())
  facilityId        String
  lastName          String
  firstName         String
  lastNameKana      String?
  firstNameKana     String?
  dateOfBirth       DateTime
  gender            String    // male, female, other
  careLevel         Int?      // 要介護度 0-5 (0=要支援)
  admissionDate     DateTime?
  dischargeDate     DateTime?
  status            String    @default("active") // active, discharged, deceased

  // 医療情報フラグ（軽く持つ）
  hasMedicalNeeds   Boolean   @default(false)
  hasAllergies      Boolean   @default(false)

  // 緊急連絡先
  emergencyContact  String?
  emergencyPhone    String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  facility          Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  incidentReports   IncidentReport[]

  @@index([facilityId])
  @@index([status])
  @@map("residents")
}

// 職員
model Staff {
  id                String    @id @default(cuid())
  facilityId        String
  employeeNumber    String    @unique // 職員番号
  lastName          String
  firstName         String
  lastNameKana      String?
  firstNameKana     String?
  email             String?   @unique
  phone             String?

  // 雇用情報
  position          String    // 役職（施設長、管理者、介護職員等）
  employmentType    String    // 雇用形態（正社員、パート、派遣等）
  hireDate          DateTime
  resignationDate   DateTime?
  status            String    @default("active") // active, on_leave, resigned

  // 資格
  qualifications    String[]  // 介護福祉士、看護師等（配列で保持）

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  facility          Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  shifts            Shift[]
  incidentReports   IncidentReport[]
  assignedTasks     Task[]

  @@index([facilityId])
  @@index([status])
  @@map("staff")
}

// シフト（外部のshift-scheduler-v3から取り込み）
model Shift {
  id                String    @id @default(cuid())
  facilityId        String
  staffId           String
  date              DateTime  @db.Date
  shiftType         String    // early, day, late, night 等
  startTime         String?   // HH:mm形式
  endTime           String?   // HH:mm形式

  // メタ情報
  importedFrom      String?   // インポート元システム識別子
  importedAt        DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  facility          Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  staff             Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([facilityId, staffId, date, shiftType])
  @@index([facilityId, date])
  @@index([staffId, date])
  @@map("shifts")
}

// 請求単位
model Claim {
  id                String    @id @default(cuid())
  facilityId        String
  yearMonth         String    // YYYY-MM形式
  amount            Int       // 金額（円）
  status            String    @default("draft") // draft, submitted, approved, paid

  // 詳細情報
  billingDate       DateTime?
  paymentDate       DateTime?
  note              String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  facility          Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, yearMonth])
  @@index([facilityId])
  @@index([status])
  @@map("claims")
}

// 事故・ヒヤリハット報告
model IncidentReport {
  id                String    @id @default(cuid())
  facilityId        String
  residentId        String?   // 対象利用者（任意）
  reporterId        String    // 報告者（職員）

  incidentType      String    // accident, near_miss 等
  severity          String    // low, medium, high, critical
  occurredAt        DateTime  // 発生日時
  location          String?   // 発生場所

  description       String    @db.Text // 状況説明
  actionTaken       String?   @db.Text // 対応内容
  preventiveMeasure String?   @db.Text // 再発防止策

  status            String    @default("reported") // reported, reviewed, closed

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  facility          Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  resident          Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  reporter          Staff     @relation(fields: [reporterId], references: [id])

  @@index([facilityId])
  @@index([status])
  @@index([occurredAt])
  @@map("incident_reports")
}

// ToDo/業務タスク
model Task {
  id                String    @id @default(cuid())
  facilityId        String
  title             String
  description       String?   @db.Text
  status            String    @default("todo") // todo, in_progress, done
  priority          String    @default("medium") // low, medium, high, urgent

  assigneeId        String?   // 担当者
  dueDate           DateTime?
  completedAt       DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  facility          Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  assignee          Staff?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([facilityId])
  @@index([status])
  @@index([assigneeId])
  @@map("tasks")
}

// 文書管理
model Document {
  id                String    @id @default(cuid())
  facilityId        String
  title             String
  type              String    // care_plan, contract, report 等
  category          String?   // カテゴリ分類

  // ストレージ情報
  storagePath       String    // ファイルパス or オブジェクトストレージキー
  fileSize          Int?      // バイト数
  mimeType          String?

  // メタ情報
  uploadedBy        String?   // アップロードした職員ID
  uploadedAt        DateTime  @default(now())

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  facility          Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([type])
  @@map("documents")
}
